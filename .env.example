# ═══════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
# For local dev, leave empty (uses SQLite fallback)
# For production, set PostgreSQL connection string
DATABASE_URL=postgresql://scraper:changeme@localhost:5432/jobscraper

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API Security ───────────────────────────────────────────────
# Set to "true" to require API keys for all endpoints
REQUIRE_API_KEY=false

# Admin key for /api/keys/generate and /api/keys/revoke
ADMIN_API_KEY=

# Pre-configured API keys (comma-separated)
API_KEYS=

# Rate limit: requests per minute per API key
RATE_LIMIT_RPM=120

# ── Scraper Settings ──────────────────────────────────────────
# Set to "true" to enable proxy rotation
USE_PROXIES=false

# Proxy source: free | env | brightdata | smartproxy
PROXY_SOURCE=free

# Comma-separated proxy URLs (if PROXY_SOURCE=env)
PROXY_LIST=

# ── Paid Proxy Services ───────────────────────────────────────
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
SMARTPROXY_API_KEY=

# ── Alerts (Telegram) ─────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get from @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ── Alerts (Email) ────────────────────────────────────────────
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Deployment ────────────────────────────────────────────────
API_PORT=8000
