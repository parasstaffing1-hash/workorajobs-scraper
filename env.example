# Workora Jobs - Environment Variables
# Copy this file to .env and fill in your values

# =============================================
# Cloudflare R2 Storage (FREE - 10GB)
# =============================================
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=workora-jobs
# Optional: Public URL for accessing files
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# =============================================
# Email Alerts (Gmail SMTP - FREE)
# =============================================
# Get app password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=alerts@workorajobs.com

# =============================================
# Database (Optional - for Vercel deployment)
# =============================================
# If using Supabase or other PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# =============================================
# Vercel Deployment (Optional)
# =============================================
# VERCEL_URL=workorajobs.vercel.app
